# -------------------------------------------------------------------------
# .env.example
# -------------------------------------------------------------------------
# Kopiere diese Datei nach .env.local und trage die echten Werte ein.
# .env.local ist per .gitignore ausgeschlossen und wird nie committed.
# Für das Vercel-Deployment werden die Variablen in den Vercel Project
# Settings > Environment Variables hinterlegt.
# -------------------------------------------------------------------------

# --- Basis -----------------------------------------------------------------
# Basis-URL der Website. Wird für Canonicals und Sitemap verwendet.
NEXT_PUBLIC_SITE_URL="https://www.pb-fahrzeugpflege.de"

# --- Google Tag Manager ---------------------------------------------------
# Container-ID aus der Altseite. Nicht neu anlegen, sonst bricht das Tracking.
NEXT_PUBLIC_GTM_ID="GTM-PM4LRKZ"

# --- CookieYes (Consent-Management) ---------------------------------------
# Client-ID aus der Altseite.
NEXT_PUBLIC_COOKIEYES_ID="882f35b4b9e022f15719da7e"

# --- Kontaktformular (Server-seitig) --------------------------------------
# SMTP-Zugang für den Versand der Formular-Anfragen an info@pb-fahrzeugpflege.de.
# NICHT NEXT_PUBLIC_-Präfix, damit die Werte nur serverseitig verwendet werden.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@pb-fahrzeugpflege.de"
CONTACT_TO="info@pb-fahrzeugpflege.de"

# --- hCaptcha (Formular-Spamschutz) ---------------------------------------
# Site-Key ist öffentlich, Secret ist serverseitig.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=""
HCAPTCHA_SECRET=""

# --- Payload CMS (kommt in Schritt 8) -------------------------------------
# Datenbank-URL für Neon oder Supabase (Postgres). Beispiel:
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"
DATABASE_URL=""

# Payload benötigt einen Secret zur Sitzungssignierung.
# Erzeuge mit: openssl rand -base64 32
PAYLOAD_SECRET=""

# Payload-Admin-URL (Standard: /admin)
PAYLOAD_PUBLIC_SERVER_URL="https://www.pb-fahrzeugpflege.de"

# --- ProvenExpert (optional, für Live-Rating-Abruf) -----------------------
# Falls die Bewertungszahl später dynamisch aus der ProvenExpert-API
# gezogen werden soll (statt statisch aus SITE.ratings).
PROVENEXPERT_API_KEY=""
